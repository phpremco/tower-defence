%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a15bf932f8097bf44b17bc60e18e1d0d, type: 3}
  m_Name: CombatRules
  m_EditorClassIdentifier: Game.Core::Game.Core.CombatRules
  _damage:
  - Type: 0
    Armour: 1
    Air: 1
    Reason: 'A blast strips armour point for point and bursts among flyers. (A shell still cannot be aimed up: that is the Cannon''s targets, not its damage.)'
  - Type: 1
    Armour: 0.2
    Air: 0.2
    Reason: 'Light fire only chips armour, and a gun not made for the sky lands a fifth up there: enough to finish a straggler, never an air defence.'
  - Type: 2
    Armour: 0.1
    Air: 0.2
    Reason: A beam glances off plates, and a pulse this small barely marks them; it spreads out over the distance to a flyer.
  - Type: 3
    Armour: 0.5
    Air: 0
    Reason: A blade cuts armour at half. It never reaches the sky.
  - Type: 4
    Armour: 0.2
    Air: 0.4
    Reason: Lightning runs over plates instead of through them, like the other light fire, and thins out on its way up.
  - Type: 5
    Armour: 0.5
    Air: 0
    Reason: Fire heats armour at half. It burns on the ground.
  - Type: 6
    Armour: 0.5
    Air: 0
    Reason: A ram dents armour at half. It drives on the ground.
  - Type: 7
    Armour: 1.5
    Air: 0.5
    Reason: 'A slug is made for armour: it works on plates better than on the body. One slow shot is a poor way to hunt flyers.'
  _families:
  - Type: 2
    Family: 1
    Factor: 1.5
    Reason: A beam feeds straight into an energy body and overloads it.
  _exceptions:
  - Weapon: Rocket
    Trait: 1
    Factor: 0.5
    Reason: 'The Flak''s airburst is fragments, not a shell: it is the air specialist and no anti-armour gun (Remco 2026-11-15). No armoured flyer exists today.'
  _swarmHealth: 40
  _toughHealth: 250
  _fastSpeed: 1.3
  _scenarios:
  - Trait: 4
    Enemy: Skitter
    Count: 12
    Spacing: 1.5
    Moving: 1
    Margin: 1.15
    Reason: 'A stream of a dozen Skitters, a blast apart: every hit bigger than one of them is wasted, so light fire wins.'
  - Trait: 8
    Enemy: Oozer
    Count: 5
    Spacing: 0.5
    Moving: 0
    Margin: 1.25
    Reason: 'Five Oozers queued at a gate: one blast takes three.'
  - Trait: 16
    Enemy: ShardCrawler
    Count: 1
    Spacing: 1
    Moving: 0
    Margin: 1.15
    Reason: 'One Shard Crawler: a big soft body asks for light fire held on one target.'
  - Trait: 1
    Enemy: Cragback
    Count: 3
    Spacing: 0.6
    Moving: 0
    Margin: 2
    Reason: 'Three Cragbacks at a gate: light fire chips the plates, shells and slugs break them.'
  - Trait: 2
    Enemy: Skyray
    Count: 4
    Spacing: 0.8
    Moving: 1
    Margin: 2
    Reason: 'A wing of four Skyrays: only the sky guns land in full.'
  - Trait: 32
    Enemy: Roller
    Count: 1
    Spacing: 1
    Moving: 1
    Margin: 1.15
    Reason: 'One Roller at speed: an unguided shell lands where it was.'
  _healthLadder:
  - 0.75
  - 1
  - 1.5
  - 2.25
  _lateHealthScale: 6
  _helperHorizonSeconds: 120
  _freeHelperCoins: 100
  _graceWaves: 02000000010000000100000000000000i
  _fallWithinWaves: 04000000040000000300000003000000i
