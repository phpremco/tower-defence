  m_Script: {fileID: 11500000, guid: d739c3f664720374da6d2402ae0ff1fc, type: 3}
  m_Name: Dlg_Warn_RearRift
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Warn_RearRift.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Wait, that reading is behind our gate. A rift is opening past the defences.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Warn_RearRift.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Whatever crawls out never meets the gate. Keep a turret in reach of it, or near the base.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Warn_RearRift.03
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: And watch the whole map. I doubt this is the last one that opens where we don't expect it.
      Style: 0
    GlitchIntensity: 0
  _introducedDrones: []
  _codexEntry: {fileID: 0}
