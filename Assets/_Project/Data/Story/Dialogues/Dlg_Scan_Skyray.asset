  _lines:
  - Id: Dlg_Scan_Skyray.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Scan done. All wing and a spiked tail, and it stays in the air the whole way.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Scan_Skyray.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: 'Ground guns can''t touch it. The Flak Turret can: build one where it crosses the gates.'
      Style: 0
    GlitchIntensity: 0
