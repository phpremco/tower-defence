  m_Script: {fileID: 11500000, guid: d739c3f664720374da6d2402ae0ff1fc, type: 3}
  m_Name: Dlg_Tip_MoveSpencer
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Tip_MoveSpencer.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Spencer, your gate is quiet, but another one is being hammered.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_MoveSpencer.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: 'Go where the fight is. The jetpack gets you there in seconds: Next post, or select that gate and send Spencer.'
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_MoveSpencer.03
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: When the pressure shifts, shift with it. A blade at the right gate beats a turret at the wrong one.
      Style: 0
    GlitchIntensity: 0
  _introducedDrones: []
  _codexEntry: {fileID: 0}
