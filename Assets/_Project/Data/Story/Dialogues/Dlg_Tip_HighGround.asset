  m_Script: {fileID: 11500000, guid: d739c3f664720374da6d2402ae0ff1fc, type: 3}
  m_Name: Dlg_Tip_HighGround
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Tip_HighGround.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: 'Good, the first turret stands. Now look for the rises: ground with a glowing seam round its bank.'
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_HighGround.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: 'That is high ground. A turret on top of it sees further: 10% more range. The range ring shows it before you build.'
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_HighGround.03
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: The bank itself is too steep for a turret, so only the top counts. Take it where the road passes close.
      Style: 0
    GlitchIntensity: 0
  _introducedDrones: []
  _codexEntry: {fileID: 0}
  _loadingTip: Towers on high ground reach 10% further. The bank round it is too steep to build on.
