  _lines:
  - Id: Dlg_Intro_FrostWarden.01
    Speaker: {fileID: 11400000, guid: ec0783780d5f0984e914d56fe2fe7adf, type: 2}
    Segments:
    - Text: It freezes barricades and walks through them. Fire cracks its armour.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Intro_FrostWarden.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Those glyphs on its armour... it isn't hunting. It's guarding something.
      Style: 0
    GlitchIntensity: 0
