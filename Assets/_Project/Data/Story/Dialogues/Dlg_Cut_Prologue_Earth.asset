  m_Script: {fileID: 11500000, guid: d739c3f664720374da6d2402ae0ff1fc, type: 3}
  m_Name: Dlg_Cut_Prologue_Earth
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Cut_Prologue_Earth.01
    Speaker: {fileID: 11400000, guid: ec0783780d5f0984e914d56fe2fe7adf, type: 2}
    Segments:
    - Text: 'The year is 2053. Earth is empty. Lithium, cobalt, rare earth metals: the last mines have been dug down to bedrock.'
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Cut_Prologue_Earth.02
    Speaker: {fileID: 11400000, guid: ec0783780d5f0984e914d56fe2fe7adf, type: 2}
    Segments:
    - Text: No raw materials means no batteries, no chips, no energy. Humanity's hunger for technology has outgrown what this planet can still give.
      Style: 0
    GlitchIntensity: 0
