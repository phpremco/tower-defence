  m_Name: Dlg_Scan_Mossbat
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Scan_Mossbat.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: That big flyer is shedding bats. Same species as the stone ones, I think. Fascinating.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Scan_Mossbat.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Air only as well. Keep a Flak Turret in reach of wherever it goes.
      Style: 0
    GlitchIntensity: 0
