  _lines:
  - Id: Dlg_Scan_Shalebat.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: The bats live inside the stone nests. They spit at the turrets they fly past.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Scan_Shalebat.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Air only. A Flak Turret beside the nests takes them before they reach the guns.
      Style: 0
    GlitchIntensity: 0
