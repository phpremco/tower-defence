  _lines:
  - Id: Dlg_L06_Start.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: The crystals never run dry. Never. This changes everything.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_L06_Start.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: 'For now: a mine with a serious blast, and a field that slows time around those fast little critters.'
      Style: 0
