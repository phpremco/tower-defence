  m_Script: {fileID: 11500000, guid: d739c3f664720374da6d2402ae0ff1fc, type: 3}
  m_Name: Dlg_Cut_Prologue_Survey
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Cut_Prologue_Survey.01
    Speaker: {fileID: 11400000, guid: ec0783780d5f0984e914d56fe2fe7adf, type: 2}
    Segments:
    - Text: 'Yet there is hope. With AI, spaceflight advanced more in a few years than in the century before: new drives, self-building ships, telescopes that scan thousands of worlds at once.'
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Cut_Prologue_Survey.02
    Speaker: {fileID: 11400000, guid: ec0783780d5f0984e914d56fe2fe7adf, type: 2}
    Segments:
    - Text: 'One world stands out: S-69-CRYS. Its soil is full of the metals we need, and everywhere lie crystals we cannot place. They give off a faint, constant energy, as if they never run dry.'
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Cut_Prologue_Survey.03
    Speaker: {fileID: 11400000, guid: ec0783780d5f0984e914d56fe2fe7adf, type: 2}
    Segments:
    - Text: 'Breathable air, liquid water, a stable climate: every ingredient for life. Yet no cities, no lights, no signals. Nothing moves. A few strange heat sources below the surface were written off as volcanic activity.'
      Style: 0
    GlitchIntensity: 0
