  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d739c3f664720374da6d2402ae0ff1fc, type: 3}
  m_Name: Dlg_Tip_UpgradeScreen
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Tip_UpgradeScreen.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Welcome to the research bay. Every level you clear pays research points, and a harder difficulty pays more.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_UpgradeScreen.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Spend them here on tiers. Each tier makes a turret, the base or the gates better for good; the drones take power instead.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_UpgradeScreen.03
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: A padlock means that tier opens on a later continent. Crystal Plains opens the first 4; there are ten.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_UpgradeScreen.04
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: 'And do look after Spencer: a repair drone that mends him faster, and armour that takes the edge off every hit.'
      Style: 0
    GlitchIntensity: 0
  _introducedDrones: []
  _codexEntry: {fileID: 0}
  _loadingTip: Research points buy permanent upgrade tiers between levels. A padlocked tier opens on a later continent.
