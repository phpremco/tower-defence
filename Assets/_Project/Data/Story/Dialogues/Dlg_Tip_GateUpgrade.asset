  m_Script: {fileID: 11500000, guid: d739c3f664720374da6d2402ae0ff1fc, type: 3}
  m_Name: Dlg_Tip_GateUpgrade
  m_EditorClassIdentifier: Game.Levels::Game.Levels.DialogueDefinition
  _lines:
  - Id: Dlg_Tip_GateUpgrade.01
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: 'That gate is taking hits. You can reinforce it right now: select the gate and upgrade it.'
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_GateUpgrade.02
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Every gate level makes it tougher and adds a small turret of its own. A gate that holds longer gives every gun around it more time to shoot.
      Style: 0
    GlitchIntensity: 0
  - Id: Dlg_Tip_GateUpgrade.03
    Speaker: {fileID: 11400000, guid: e89dfee39866cb34fb15a2a8657f5b41, type: 2}
    Segments:
    - Text: Upgrade the gate where they pile up first. A repair patches it; an upgrade makes it worth defending.
      Style: 0
    GlitchIntensity: 0
  _introducedDrones: []
  _codexEntry: {fileID: 0}
